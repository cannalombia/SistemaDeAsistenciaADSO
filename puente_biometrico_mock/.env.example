# Archivo: .env.example
#
# Propósito: documentar las variables necesarias para iniciar el puente mock.
# Responsabilidad: mostrar una configuración local de ejemplo sin guardar secretos reales.
# Comunicación: la variable es leída por servidor_mock.js desde el entorno del proceso.
# Límites: este archivo no inicia servicios, no contiene datos biométricos y no debe usarse
# como almacén de una clave de producción.

CLAVE_LOCAL_PUENTE=cambie-esta-clave-local
