# Cuando exista MySQL InnoDB Cluster, apunta Blue Magic al endpoint RW de MySQL Router.
# Estos valores son de ejemplo; el puerto exacto depende de la configuración de Router.
DATA_SOURCE=mysql
DB_HOST=127.0.0.1
DB_PORT=6446
DB_USER=sena_app
DB_PASSWORD=CAMBIAR
DB_NAME=sistema_asistencia_sena
DB_POOL_SIZE=10
