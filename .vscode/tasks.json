{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Preparar servidor SENA",
            "type": "shell",
            "command": "npm.cmd",
            "args": ["run", "start:ensure"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "silent",
                "panel": "shared",
                "clear": true
            }
        },
        {
            "label": "Revisar estado del servidor SENA",
            "type": "shell",
            "command": "npm.cmd",
            "args": ["run", "status"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        },
        {
            "label": "Ejecutar pruebas del proyecto",
            "type": "shell",
            "command": "npm.cmd",
            "args": ["test"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        }
    ]
}
