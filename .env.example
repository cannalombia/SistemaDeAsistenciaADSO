# MySQL es la persistencia operacional definitiva.
DATA_SOURCE=mysql
PORT=3000
PUBLIC_URL=

# MySQL (usa una cuenta exclusiva; root está rechazado por la aplicación).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=sena_app
DB_PASSWORD=cambiar_por_una_clave_larga
DB_MIGRATION_USER=sena_migrator
DB_MIGRATION_PASSWORD=
DB_NAME=sistema_asistencia_sena
DB_NAME_TEST=sistema_asistencia_sena_test
DB_POOL_SIZE=10

# Reportes: máximo conservado; al llenarse se depuran primero los archivados más antiguos.
REPORTS_RETENTION_LIMIT=500

# Correo (configura uno de los proveedores).
GMAIL_USER=
GMAIL_APP_PASSWORD=
RESEND_API_KEY=
EMAIL_FROM=

# Seguridad.
OTP_SECRET=
COOKIE_SECURE=0

# Credenciales integradas (genera valores locales; no copies credenciales reales aquí).
ADMIN_AUTH_SALT=
ADMIN_AUTH_PASSWORD_HASH=
ADMIN_AUTH_NAME=Administrador SENA
ADMIN_AUTH_EMAIL=admin@sena.edu.co
INSTRUCTOR_AUTH_SALT=
INSTRUCTOR_AUTH_PASSWORD_HASH=
INSTRUCTOR_AUTH_NAME=Instructor SENA
INSTRUCTOR_AUTH_EMAIL=instructor@sena.edu.co

# Resiliencia y multi-instancia.
# En producción con balanceador usa un INSTANCE_ID distinto por proceso (node-01, node-02...).
INSTANCE_ID=node-01
# Si usas MySQL Router, DB_PORT normalmente apunta al puerto de escritura del Router (por ejemplo 6446).
# DB_HOST=127.0.0.1
# DB_PORT=6446
BACKUP_DIR=

# Protección HTTP / cierre ordenado.
HTTP_REQUEST_TIMEOUT_MS=30000
HTTP_HEADERS_TIMEOUT_MS=15000
HTTP_KEEPALIVE_TIMEOUT_MS=5000
HTTP_MAX_REQUESTS_PER_SOCKET=1000
SHUTDOWN_GRACE_MS=10000

# Circuit breaker de correo.
EMAIL_CIRCUIT_FAILURE_THRESHOLD=5
EMAIL_CIRCUIT_RESET_MS=30000
# Activa X-Forwarded-For solo cuando Blue Magic esté detrás de un proxy propio y confiable.
TRUST_PROXY=0
