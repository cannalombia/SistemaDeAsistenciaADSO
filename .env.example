# Copia este archivo como .env y completa los valores.
# Opción recomendada para pruebas: Gmail con contraseña de aplicación.
EMAIL_PROVIDER=gmail
GMAIL_USER=correo_remitente@gmail.com
GMAIL_APP_PASSWORD=contraseña_de_aplicacion_de_16_caracteres
EMAIL_FROM=Sistema SENA <correo_remitente@gmail.com>

# Alternativa: cambia EMAIL_PROVIDER=resend y completa esta clave.
RESEND_API_KEY=re_reemplaza_con_tu_clave

# Separa los envios para no superar el limite del proveedor (milisegundos).
EMAIL_MIN_INTERVAL_MS=300
OTP_SECRET=cambia_esto_por_una_frase_larga_y_aleatoria

# Opcionales: limita quiénes pueden entrar por correo.
# ALLOWED_EMAIL_DOMAIN=sena.edu.co
# ALLOWED_EMAILS=usuario1@ejemplo.com,usuario2@ejemplo.com

# Actívalo solamente al publicar el sitio con HTTPS.
COOKIE_SECURE=0
