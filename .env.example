# Persistencia operacional.
DATA_SOURCE=mysql
PORT=3000
PUBLIC_URL=

# MySQL. Usa cuentas exclusivas; la aplicación rechaza el usuario root.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=sena_app
DB_PASSWORD=
DB_MIGRATION_USER=sena_migrator
DB_MIGRATION_PASSWORD=
DB_NAME=sistema_asistencia_sena
DB_NAME_TEST=sistema_asistencia_sena_test
DB_POOL_SIZE=10
# Opcional si Windows tiene más de un servicio mysqld instalado.
MYSQL_SERVICE_NAME=

# Límite de reportes conservados.
REPORTS_RETENTION_LIMIT=500

# Correo. Configura Gmail o Resend, no ambos obligatoriamente.
EMAIL_PROVIDER=
GMAIL_USER=
GMAIL_APP_PASSWORD=
RESEND_API_KEY=
EMAIL_FROM=
ALLOWED_EMAILS=
ALLOWED_EMAIL_DOMAIN=

# Seguridad. Genera valores propios y no publiques el archivo .env.
OTP_SECRET=
COOKIE_SECURE=0
ADMIN_AUTH_SALT=
ADMIN_AUTH_PASSWORD_HASH=
ADMIN_AUTH_NAME=Administrador SENA
ADMIN_AUTH_EMAIL=admin@sena.edu.co
INSTRUCTOR_AUTH_SALT=
INSTRUCTOR_AUTH_PASSWORD_HASH=
INSTRUCTOR_AUTH_NAME=Instructor SENA
INSTRUCTOR_AUTH_EMAIL=instructor@sena.edu.co

# Resiliencia y despliegue.
INSTANCE_ID=node-01
BACKUP_DIR=
HTTP_REQUEST_TIMEOUT_MS=30000
HTTP_HEADERS_TIMEOUT_MS=15000
HTTP_KEEPALIVE_TIMEOUT_MS=5000
HTTP_MAX_REQUESTS_PER_SOCKET=1000
SHUTDOWN_GRACE_MS=10000
EMAIL_TIMEOUT_MS=10000
EMAIL_MAX_ATTEMPTS=3
EMAIL_RETRY_BASE_MS=500
EMAIL_MIN_INTERVAL_MS=300
EMAIL_HISTORY_LIMIT=500
EMAIL_CIRCUIT_FAILURE_THRESHOLD=5
EMAIL_CIRCUIT_RESET_MS=30000
TRUST_PROXY=0

# Biometría. BIOMETRIC_SERVICE_URL es la fuente única del puerto del puente local.
# Mantén 127.0.0.1; el supervisor pasa ese mismo puerto al puente mock o real.
# Las claves se generan localmente y nunca deben publicarse.
BIOMETRIC_ENABLED=false
BIOMETRIC_MODE=mock
BIOMETRIC_SERVICE_URL=http://127.0.0.1:4318
BIOMETRIC_SERVICE_KEY=
BIOMETRIC_ENCRYPTION_KEY=
BIOMETRIC_TIMEOUT_MS=5000
